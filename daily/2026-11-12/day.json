      "questions": [
        {
          "text": "「晴天」的「晴」，部首是哪一個？",
          "options": [
            "日",
            "目",
            "氵",
            "言"
          ],
          "answer": "日",
          "explain": "晴天的時候太陽出來了，和太陽有關，所以「晴」的左邊是「日」。"
        },
        {
          "text": "選出正確的字：<br>今天是（　）天，太陽好大。",
          "options": [
            "晴",
            "睛",
            "清",
            "請"
          ],
          "answer": "晴",
          "explain": "太陽出來的好天氣叫「晴天」，要用日字旁的「晴」。",
          "say": "今天是什麼天，太陽好大"
        },
        {
          "text": "選出正確的字：<br>小貓的眼（　）圓圓的。",
          "options": [
            "睛",
            "晴",
            "情",
            "清"
          ],
          "answer": "睛",
          "explain": "「眼睛」和眼睛有關，要用目字旁的「睛」。「晴」的左邊是日，是晴天的晴。",
          "say": "小貓的眼什麼圓圓的"
        },
        {
          "text": "選出正確的字：<br>河水很（　），可以看到小魚。",
          "options": [
            "清",
            "晴",
            "請",
            "睛"
          ],
          "answer": "清",
          "explain": "水很乾淨、看得到底叫「清」，和水有關，所以是三點水的「清」。",
          "say": "河水很什麼，可以看到小魚"
        },
        {
          "text": "選出正確的字：<br>（　）你幫我開門，謝謝！",
          "options": [
            "請",
            "清",
            "情",
            "晴"
          ],
          "answer": "請",
          "explain": "「請」是很有禮貌地說話，和說話有關，所以左邊是言字旁。",
          "say": "什麼你幫我開門，謝謝"
        },
        {
          "text": "選出正確的字：<br>考了一百分，我的心（　）很好。",
          "options": [
            "情",
            "晴",
            "請",
            "清"
          ],
          "answer": "情",
          "explain": "「心情」說的是心裡的感覺，和心有關，所以是豎心旁的「情」。",
          "say": "考了一百分，我的心什麼很好"
        },
        {
          "text": "「眼睛」的「睛」為什麼是目字旁？",
          "options": [
            "因為和眼睛有關",
            "因為和太陽有關",
            "因為和水有關",
            "因為和說話有關"
          ],
          "answer": "因為和眼睛有關",
          "explain": "「目」就是眼睛的意思，所以和眼睛有關的「睛」是目字旁。和太陽有關的是「晴」，和水有關的是「清」，和說話有關的是「請」。"
        },
        {
          "text": "晴、睛、清、請、情，這五個字的右邊都一樣，是哪一個字？",
          "options": [
            "青",
            "月",
            "主",
            "清"
          ],
          "answer": "青",
          "explain": "這五個字的右邊都是「青」，只有左邊不一樣：日（晴）、目（睛）、氵（清）、言（請）、忄（情）。看左邊就知道意思。"
        }
      ]
