      "questions": [
        {
          "text": "12 公分 + 5 公分 = ？ 公分",
          "options": [
            "17",
            "7",
            "16"
          ],
          "answer": "17",
          "explain": "長度相加，數字照樣加，單位不變：12 + 5 = 17，所以是 17 公分。"
        },
        {
          "text": "30 公分 − 8 公分 = ？ 公分",
          "options": [
            "38",
            "22",
            "32"
          ],
          "answer": "22",
          "explain": "個位 0 不夠減 8，要向十位借 1：10 − 8 = 2；十位剩 2。<br>所以 30 − 8 = 22 公分。不能倒過來用 8 − 0 唷！"
        },
        {
          "text": "紅線長 9 公分，藍線長 14 公分。<br>藍線比紅線長幾公分？",
          "options": [
            "6",
            "5",
            "23"
          ],
          "answer": "5",
          "explain": "「比……長幾公分」要用長的減短的：14 − 9 = 5，所以藍線長 5 公分。",
          "visual": "<div style=\"font-size:24px\">🟥 9 公分<br>🟦 14 公分</div>"
        },
        {
          "text": "一條緞帶長 46 公分，剪掉 18 公分，還剩幾公分？",
          "options": [
            "28",
            "64",
            "32"
          ],
          "answer": "28",
          "explain": "剪掉就是減：46 − 18。<br>個位 6 不夠減 8，向十位借 1：16 − 8 = 8；十位 4 − 1 − 1 = 2。所以剩 28 公分。"
        },
        {
          "text": "兩條跳繩，一條長 37 公分，一條長 45 公分。<br>接起來（不重疊）一共長幾公分？",
          "options": [
            "72",
            "8",
            "82"
          ],
          "answer": "82",
          "explain": "一共是加起來：37 + 45。<br>個位 7 + 5 = 12，寫 2 進 1；十位 3 + 4 + 1 = 8，所以是 82 公分。別忘了進位！"
        },
        {
          "text": "小安的書桌長 80 公分，小樂的書桌比小安的短 15 公分。<br>小樂的書桌長幾公分？",
          "options": [
            "75",
            "95",
            "65"
          ],
          "answer": "65",
          "explain": "比較短，所以要減：80 − 15。<br>個位 0 不夠減 5，借 1：10 − 5 = 5；十位 8 − 1 − 1 = 6。所以是 65 公分。"
        },
        {
          "text": "一條毛巾長 1 公尺，剪下 30 公分，還剩幾公分？",
          "options": [
            "70",
            "29",
            "130"
          ],
          "answer": "70",
          "explain": "先把 1 公尺換成 100 公分，單位一樣才能減。<br>100 − 30 = 70，所以還剩 70 公分。不能直接用 1 和 30 相減唷！"
        },
        {
          "text": "鉛筆長 14 公分，原子筆比鉛筆長 3 公分。<br>兩枝筆接起來（不重疊）一共長幾公分？",
          "options": [
            "17",
            "31",
            "28"
          ],
          "answer": "31",
          "explain": "要算兩步：<br>① 原子筆比鉛筆長 3 公分：14 + 3 = 17 公分。<br>② 兩枝接起來：14 + 17 = 31 公分。",
          "visual": "<div style=\"font-size:28px\">✏️ 🖊️</div>"
        }
      ]
    }
