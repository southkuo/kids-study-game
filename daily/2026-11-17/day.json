      "questions": [
        {
          "text": "選出正確的字：<br>小安（　）教室裡看書。",
          "options": [
            "在",
            "再"
          ],
          "answer": "在",
          "explain": "說「在什麼地方」要用「在」。小安在「教室裡」，是說地方，所以用「在」。",
          "say": "小安，什麼，教室裡看書"
        },
        {
          "text": "選出正確的字：<br>這個故事好好聽，請老師（　）說一次。",
          "options": [
            "在",
            "再"
          ],
          "answer": "再",
          "explain": "「再」是「又一次」的意思。想聽老師「又說一次」，所以用「再」。",
          "say": "這個故事好好聽，請老師，什麼，說一次"
        },
        {
          "text": "選出正確的字：<br>放學了，我們明天（　）見！",
          "options": [
            "在",
            "再"
          ],
          "answer": "再",
          "explain": "「再見」是下一次又見面的意思，「再」表示又一次，所以寫「再見」。",
          "say": "放學了，我們明天，什麼，見"
        },
        {
          "text": "選出正確的字：<br>小貓躲（　）桌子下面。",
          "options": [
            "在",
            "再"
          ],
          "answer": "在",
          "explain": "「桌子下面」是一個地方。說東西或動物在哪裡，要用「在」。",
          "say": "小貓躲，什麼，桌子下面"
        },
        {
          "text": "選出正確的字：<br>豆豆吃完一碗飯，還想（　）吃一碗。",
          "options": [
            "在",
            "再"
          ],
          "answer": "再",
          "explain": "吃完一碗，還想「又吃一碗」，是又一次的意思，所以用「再」。",
          "say": "豆豆吃完一碗飯，還想，什麼，吃一碗"
        },
        {
          "text": "選出正確的字：<br>媽媽在廚房（　）蛋糕。",
          "options": [
            "做",
            "作"
          ],
          "answer": "做",
          "explain": "用手動手做出東西，例如做蛋糕、做家事，要用「做」。",
          "say": "媽媽在廚房，什麼，蛋糕"
        },
        {
          "text": "選出正確的字：<br>老師請我們寫一篇（　）文。",
          "options": [
            "做",
            "作"
          ],
          "answer": "作",
          "explain": "「作文」是固定的寫法，就像「作家」一樣用「作」。",
          "say": "老師請我們寫一篇，什麼，文"
        },
